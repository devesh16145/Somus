# Copy this file to `android/keystore.properties` and fill in real values.
# DO NOT commit the real file — it's gitignored.
#
# Generate a release keystore (one-time, valid 25 years):
#   cd android
#   keytool -genkeypair -v \
#     -keystore release.keystore \
#     -alias somus-release \
#     -keyalg RSA -keysize 2048 -validity 9125 \
#     -storetype PKCS12
#
# IMPORTANT: back up release.keystore + the passwords below to a password
# manager IMMEDIATELY. If you lose them you can never update the app on
# Play Store under this signing identity again.

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=somus-release
keyPassword=CHANGE_ME
